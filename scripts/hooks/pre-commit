#!/usr/bin/env bash
# ==============================================================================
# AGY Memory Engine — Git Pre-Commit Hook
# ==============================================================================
# Enforces executable bits on key scripts and CLI utilities
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 1. Enforce executable bits on key scripts
SCRIPTS=(
    "agy_memory.py"
    "agy_memory_mcp.py"
    "dashboard.py"
    "memory_worker.py"
    "scripts/cron_runner.sh"
    "scripts/auto_sync_hook.py"
    "scripts/backfill_recent.py"
    "scripts/vector_index_cli.py"
    "scripts/queue_cli.py"
    "scripts/reindex_vectors.py"
    "scripts/harness/memory-enqueue.py"
    "scripts/harness/memory-prefetch.py"
)

for script in "${SCRIPTS[@]}"; do
    if [ -f "${REPO_ROOT}/${script}" ] && [ ! -x "${REPO_ROOT}/${script}" ]; then
        chmod +x "${REPO_ROOT}/${script}"
        echo "🔧 Corrected executable permission on: ${script}"
    fi
done

exit 0
